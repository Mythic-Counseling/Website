// GitHub Codespaces: a ready-made computer in the cloud with Jekyll installed,
// so the site can be previewed from VS Code (desktop or browser) with nothing
// to install locally. See docs/3-editing-tools.md.
{
  "name": "Mythic Counseling website",
  "image": "mcr.microsoft.com/devcontainers/jekyll:2-bookworm",
  // Same Jekyll and plugins GitHub Pages uses (from the Gemfile).
  "postCreateCommand": "bundle install",
  // Starts the preview each time you open the codespace.
  "postAttachCommand": "bundle exec jekyll serve --drafts --baseurl '' --host 0.0.0.0",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "Site preview", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": { "extensions": ["redhat.vscode-yaml"] }
  }
}
