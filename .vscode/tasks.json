{
  // Terminal → Run Task… → "Preview site" (or Ctrl/⌘+Shift+B). It also starts by
  // itself when this folder is opened, once you allow automatic tasks.
  // Needs Ruby and Jekyll; setup is in docs/3-editing-tools.md.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview site",
      "detail": "Live preview at http://localhost:4000 (rebuilds and reloads on save, drafts included)",
      "type": "shell",
      "command": "jekyll serve --livereload --drafts --open-url --config \"_config.yml,_config.dev.yml\"",
      "options": { "env": { "JEKYLL_NO_BUNDLER_REQUIRE": "true" } },
      "osx": { "options": { "env": { "JEKYLL_NO_BUNDLER_REQUIRE": "true" }, "shell": { "executable": "/bin/zsh", "args": ["-lic"] } } },
      "runOptions": { "runOn": "folderOpen" },
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": { "regexp": "^\\s*(?:Liquid Exception|Error|ERROR):\\s+(.*)$", "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "(Generating|Regenerating)",
          "endsPattern": "(Server running|done in)"
        }
      }
    },
    {
      "label": "Check site builds",
      "detail": "One-off build that reports errors the way GitHub will, without starting a server",
      "type": "shell",
      "command": "jekyll build --trace",
      "options": { "env": { "JEKYLL_NO_BUNDLER_REQUIRE": "true" } },
      "osx": { "options": { "env": { "JEKYLL_NO_BUNDLER_REQUIRE": "true" }, "shell": { "executable": "/bin/zsh", "args": ["-lic"] } } },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
