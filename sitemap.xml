---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- assign pages = site.pages | where_exp: "p", "p.sitemap != false" | where_exp: "p", "p.url != '/404.html'" | concat: site.services | sort: "url" %}
{%- for p in pages %}
{%- unless p.url contains ".txt" or p.url contains ".xml" or p.url contains ".css" or p.url contains ".js" or p.url contains ".webmanifest" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>{% if p.url == "/" %}1.0{% elsif p.url contains "/services/" %}0.9{% else %}0.7{% endif %}</priority>
    {%- if p.hero_image %}
    <image:image><image:loc>{{ '/assets/images/' | append: p.hero_image | append: '-1024.webp' | absolute_url }}</image:loc></image:image>
    {%- endif %}
  </url>
{%- endunless %}
{%- endfor %}
</urlset>
