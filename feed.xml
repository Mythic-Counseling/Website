---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
  <title>{{ site.title | xml_escape }} — {{ site.data.copy.blog.heading | xml_escape }}</title>
  <subtitle>{{ site.tagline | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/blog/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/blog/' | absolute_url }}</id>
  <updated>{% if site.posts.size > 0 %}{{ site.posts.first.updated | default: site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.title | xml_escape }}</name><email>{{ site.email }}</email></author>
  {%- for p in site.posts limit: 20 %}
  <entry>
    <title>{{ p.title | xml_escape }}</title>
    <link href="{{ p.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ p.url | absolute_url }}</id>
    <published>{{ p.date | date_to_xmlschema }}</published>
    <updated>{{ p.updated | default: p.date | date_to_xmlschema }}</updated>
    {%- if p.description %}
    <summary>{{ p.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html">{{ p.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
